[Unit]
Description=Twitch Bot - Spotify Integration & Admin Dashboard
After=network.target
Documentation=https://github.com/matella/twitch-bot

[Service]
Type=simple
User=twitch-bot
Group=twitch-bot
WorkingDirectory=/opt/twitch-bot
ExecStart=/opt/twitch-bot/twitch-bot \
  -channel=${TWITCH_CHANNEL} \
  -username=${TWITCH_USERNAME} \
  -token=${TWITCH_TOKEN} \
  -spotify-id=${SPOTIFY_ID} \
  -spotify-secret=${SPOTIFY_SECRET} \
  -port=9090 \
  -db=/var/lib/twitch-bot/bot.db

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/twitch-bot

# Resource limits
MemoryLimit=256M
CPUQuota=50%

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=twitch-bot

[Install]
WantedBy=multi-user.target
