# Copie ce fichier en « .env » (même dossier) et remplis-le. Ne le commite jamais.
# Pas de guillemets ni d'espaces autour du « = ».

# --- Twitch (obligatoire) ---
# Chaîne à rejoindre (sans #)
TWITCH_CHANNEL=ta_chaine

# Deux façons de donner un compte au bot. Choisis-en UNE.
#
# A) Recommandé : une application Twitch (https://dev.twitch.tv/console). Le bot se connecte depuis
#    l'administration (bouton « Connecter » en haut) avec le compte du bot, et son jeton est
#    renouvelé automatiquement. Dans la console Twitch, déclare l'URL de redirection OAuth :
#    https://ton-domaine/auth/twitch/callback  (avec le reverse proxy ; mets la même valeur dans TWITCH_REDIRECT_URL).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URL=https://ton-domaine/auth/twitch/callback
#
# B) Jeton fixe (expire : à régénérer régulièrement). Laisse TWITCH_CLIENT_ID vide.
# Compte Twitch du bot
TWITCH_USERNAME=ton_bot
# Jeton OAuth du compte du bot, scopes chat:read et chat:edit (le préfixe « oauth: » est facultatif)
TWITCH_TOKEN=

# --- Administration (obligatoire) ---
ADMIN_USER=admin
# 8 caractères minimum
ADMIN_PASSWORD=

# --- Spotify (facultatif : sans, les demandes de musique sont désactivées) ---
SPOTIFY_ID=
SPOTIFY_SECRET=
# Doit correspondre EXACTEMENT à l'URI de redirection déclarée dans le dashboard Spotify.
# Spotify exige HTTPS, sauf pour http://127.0.0.1 (voir DEPLOYMENT.md).
# Défaut : http://127.0.0.1:<PORT>/auth/spotify/callback
# SPOTIFY_REDIRECT_URL=https://ton-domaine/auth/spotify/callback

# Délai entre deux demandes d'un même spectateur, en secondes (défaut : 30)
# SONG_COOLDOWN_SECONDS=30

# --- Incrustation du chat à l'écran (facultatif) ---
# L'incrustation est toujours active (page /overlay/chat). OVERLAY_TOKEN est facultatif :
# - vide : la page est accessible sans jeton à quiconque peut joindre le serveur ;
# - défini (16 caractères minimum) : il faut ajouter ?token=LE_JETON à l'URL.
# Source navigateur OBS : http://127.0.0.1:9190/overlay/chat (fond transparent, largeur/hauteur au choix).
# Les réglages d'affichage se font dans l'administration (section « Incrustation du chat »).
# Les badges viennent de l'API Twitch : TWITCH_CLIENT_ID et TWITCH_CLIENT_SECRET doivent être renseignés.
# OVERLAY_TOKEN=

# --- Réseau (côté hôte Docker) ---
# true seulement derrière un reverse proxy HTTPS de confiance : le bot croit alors X-Forwarded-Proto
# (cookie « Secure ») et X-Forwarded-For (limitation des tentatives de connexion par client).
# TRUST_PROXY=true
# Adresse d'écoute : 127.0.0.1 (défaut, accès local / tunnel SSH) ou 0.0.0.0 (réseau local)
# BIND_ADDR=127.0.0.1
# Port publié sur l'hôte (défaut : 9190). Le port interne du conteneur reste 9090.
# HOST_PORT=9190
# Réseau Docker de Nginx Proxy Manager (avec docker-compose.npm.yml, voir DEPLOYMENT.md)
# NPM_NETWORK=npm_default
